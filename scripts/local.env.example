# Copy to scripts/local.env (git-ignored) and fill in. Read by scripts/device-id.sh.
# Find the ids with: xcrun devicectl list devices
#
# CoreDevice identifier of the iPhone — the id devicectl commands take.
PHONE_DEVICE_ID=
# The Watch's CoreDevice identifier, for reference; devicectl may not be able to reach a Watch.
WATCH_DEVICE_ID=
